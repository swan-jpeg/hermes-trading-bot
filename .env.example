# Copy to .env and fill in. Secrets ONLY — never in config.yaml.

# --- Broker (paper trading starts free) ---
# Alpaca paper: https://alpaca.markets -> Paper Trading -> API keys
ALPACA_API_KEY=xxxxxxxx
ALPACA_SECRET_KEY=xxxxxxxx

# --- Optional: other providers ---
# OPENROUTER_API_KEY=xxxxxxxx
# DEEPSEEK_API_KEY=xxxxxxxx

# --- Impact Agent LLM (optional) ---
# Bring your own LLM: set the API key, model id and endpoint for any
# OpenAI-compatible chat-completions service (cloud API or a local model,
# e.g. Ollama at http://localhost:11434/v1). Without a key the impact agent
# falls back to keyword matching.
# IMPORTANT:
#   - IMPACT_LLM_BASE_URL defaults to https://inference-api.nousresearch.com/v1
#     if you leave it empty. Set it to your own endpoint to use your own LLM.
#   - The impact-agent skill (impact_agent/skill/impact-agent-skill.md) is
#     loaded as the system prompt automatically when present.
# IMPACT_LLM_API_KEY=xxxxxxxx
# IMPACT_LLM_MODEL=gpt-4o-mini            # or e.g. qwen/qwen3-27b, or a local id
# IMPACT_LLM_BASE_URL=https://api.openai.com/v1
