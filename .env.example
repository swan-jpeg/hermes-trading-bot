# Copy to .env and fill in. Secrets ONLY — never in config.yaml.

# --- Broker (paper trading starts free) ---
# Alpaca paper: https://alpaca.markets -> Paper Trading -> API keys
ALPACA_API_KEY=xxxxxxxx
ALPACA_SECRET_KEY=xxxxxxxx

# --- Optional: other providers ---
# OPENROUTER_API_KEY=xxxxxxxx
# DEEPSEEK_API_KEY=xxxxxxxx

# --- Impact Agent LLM (optional, free model) ---
# Zet een gratis OpenRouter key om de impact-agent een LLM te laten gebruiken
# die gebeurtenissen interpreteert (bv. "Trump prijst Jensen Huang" -> NVDA).
# Zonder key valt de impact-agent terug op keyword-matching.
# IMPACT_LLM_API_KEY=xxxxxxxx
# IMPACT_LLM_MODEL=meta-llama/llama-3.1-8b-instruct:free
